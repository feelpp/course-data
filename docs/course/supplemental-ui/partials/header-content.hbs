          {{/with}}
        </div>
        <div class="navbar-item"><a class="navbar-brand" href="https://www.cemosis.fr"><img class="cemosis-logo" src="{{{uiRootPath}}}/img/cemosis-logo.svg" alt="Cemosis"/></a></div>
        <div class="navbar-item"><a class="navbar-brand" href="https://www.cnrs.fr"><img class="cnrs-logo" src="{{{uiRootPath}}}/img/logo-cnrs.svg" alt="CNRS"/></a></div>
        <div class="navbar-item"><a class="navbar-brand" href="https://www.unistra.fr"><img class="unistra-logo" src="{{{uiRootPath}}}/img/unistra-logo.svg" alt="Université de Strasbourg"/></a></div>
