              <span class="icon"><img src="{{{uiRootPath}}}/img/slack-icon.svg" alt=""/></span><span>Chat</span>
            </a>
            <a class="navbar-item has-icon" href="https://github.com/orgs/feelpp/discussions" target="_blank" rel="noopener">
