        <a href="{{{site.url}}}"><img src="{{{uiRootPath}}}/img/feelpp-logo.svg" alt="Feel++ documentation home"/></a>
      </div>
      <button class="navbar-burger" data-target="topbar-nav" aria-label="Open global navigation" aria-controls="topbar-nav" aria-expanded="false">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
