<div class="page-downloads">
  <span class="label">Download as</span>
  <ul class="download-options">
    <li>
      <a onclick="print(this)" href="#" data-toggle="tooltip" data-placement="left" title="Print to PDF"
         class="pdf-download">
        <img class="pdf-file-icon icon" src="{{uiRootPath}}/img/pdf.svg" alt=""/> .pdf
      </a>
    </li>
    {{#if (and (eq page.attributes.jupyter-status 'generated') page.attributes.jupyter-url)}}
      <li>
        <a href="{{relativize page.attributes.jupyter-url}}"
           title="Download Jupyter Notebook" aria-label="Download Jupyter Notebook"
           data-toggle="tooltip" data-placement="left" class="jupyter-download">
          <img class="jupyter-file-icon icon" src="{{uiRootPath}}/img/jupyter-logo.svg" alt=""/> .ipynb
        </a>
      </li>
    {{/if}}
  </ul>
</div>
