{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feelpp.github.io/course-data/schemas/asciidoc-notebook-manifest.schema.json",
  "title": "CSMI AsciiDoc notebook source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "generator", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact": { "const": "asciidoc-notebook-manifest" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "code_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "source_sha256", "dynamic", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "dynamic": { "type": "boolean" },
        "required": { "type": "boolean" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_resource_id",
        "source_path",
        "source_sha256",
        "page_url",
        "notebook_resource_id",
        "notebook_path",
        "notebook_sha256",
        "notebook_url",
        "priority",
        "difficulty",
        "concept_ids",
        "outcomes",
        "code_blocks"
      ],
      "properties": {
        "source_resource_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "pattern": "\\.adoc$" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "page_url": { "type": "string", "minLength": 1 },
        "notebook_resource_id": { "type": "string", "minLength": 1 },
        "notebook_path": { "type": "string", "pattern": "\\.ipynb$" },
        "notebook_sha256": { "$ref": "#/$defs/sha256" },
        "notebook_url": { "type": "string", "pattern": "\\.ipynb$" },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "difficulty": { "enum": ["D1", "D2", "D3"] },
        "concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "outcomes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "code_blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/code_block" }
        },
        "exercise": { "$ref": "#/$defs/exercise" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "exercise_id",
        "kind",
        "task_ids",
        "task_priorities",
        "task_points",
        "hint_policy",
        "ai_mode",
        "allowed_resources",
        "submission_evidence",
        "rubric_criteria"
      ],
      "properties": {
        "assessment_id": { "type": "string", "pattern": "^A[0-9]+$" },
        "exercise_id": { "type": "string", "pattern": "^A[0-9]+-[A-Z0-9-]+$" },
        "kind": { "enum": ["timed-specimen", "project-brief", "practice"] },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^A[0-9]+-T[0-9]+$" }
        },
        "task_priorities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["P0", "P1", "P2", "P3"] }
          }
        },
        "task_points": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "hint_policy": {
          "enum": ["specification-only", "public-checkpoints-and-rubric", "progressive-public-hints"]
        },
        "ai_mode": { "enum": ["A", "B", "C"] },
        "allowed_resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "submission_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rubric_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^R[1-9][0-9]*$" }
        }
      }
    }
  }
}
