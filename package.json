{
  "name": "course-data",
  "version": "0.1.0",
  "private": true,
  "description": "CSMI Data Processing and Mining course site",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "validate": "uv run python tools/validate_repository.py",
    "notebooks:generate": "uv run python tools/generate_notebooks.py",
    "notebooks:test": "uv run python -m tools.execute_notebooks --profile fast",
    "notebooks:test:full": "uv run python -m tools.execute_notebooks --profile full",
    "test": "uv run pytest",
    "lint": "uv run ruff check tools tests",
    "format:check": "uv run ruff format --check tools tests",
    "site": "antora --stacktrace site.yml",
    "site:check": "uv run python tools/check_site.py",
    "build": "npm run validate && npm run notebooks:test && npm run site && npm run site:check",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "serve": "http-server public -c-1 -p 8080"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@antora/cli": "3.1.15",
    "@antora/collector-extension": "1.0.3",
    "@antora/site-generator-default": "3.1.15",
    "@asciidoctor/core": "2.2.9",
    "@feelpp/antora-extensions": "1.0.0-rc.3",
    "@feelpp/asciidoctor-extensions": "1.0.0-rc.15",
    "handlebars": "4.7.9",
    "handlebars-utils": "1.0.6"
  },
  "devDependencies": {
    "http-server": "14.1.1"
  },
  "license": "SEE LICENSE.md"
}
