{
  "name": "course-data",
  "version": "0.1.0",
  "private": true,
  "description": "CSMI Data Processing and Mining course site",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "data:build": "uv run python tools/build_teaching_data.py",
    "notebooks:native-source": "uv run python -m tools.build_jax_notebook",
    "notebooks:source": "npm run notebooks:native-source",
    "setup:extensions": "uv sync --locked --all-groups --extra extensions",
    "validate": "uv run python tools/validate_repository.py",
    "notebooks:generate": "uv run python tools/generate_notebooks.py",
    "notebooks:test": "uv run python -m tools.execute_notebooks --profile fast",
    "notebooks:test:full": "uv run python -m tools.execute_notebooks --profile full",
    "test": "npm run test:python && npm run test:asciidoc",
    "test:python": "uv run pytest",
    "test:asciidoc": "node --test tests/asciidoc/*.test.cjs",
    "lint": "uv run ruff check tools tests",
    "format:check": "uv run ruff format --check tools tests",
    "audit": "node tools/audit-npm.mjs",
    "site": "uv run -- ./node_modules/.bin/antora --stacktrace site.yml && node tools/sanitise_site.mjs",
    "site:check": "uv run python tools/check_site.py && node tools/check_math_rendering.mjs",
    "release:bundle": "uv run python -m tools.build_student_bundle",
    "release:check": "uv run python -m tools.validate_student_bundle",
    "release:prepare": "npm run check && npm run notebooks:test:full && npm run release:bundle && npm run release:check",
    "release:qualify": "npm run setup:release && uv run python -m tools.qualify_release",
    "setup:release": "uv sync --locked --all-groups --extra extensions && npm ci",
    "build": "npm run validate && npm run site && npm run notebooks:test && npm run site:check",
    "check": "npm run lint && npm run format:check && npm run build && npm run test",
    "serve": "http-server public -c-1 -p 8087"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@antora/cli": "3.1.15",
    "@antora/collector-extension": "1.0.3",
    "@antora/site-generator-default": "3.2.0",
    "@asciidoctor/core": "2.2.9",
    "@feelpp/antora-extensions": "file:vendor/npm/feelpp-antora-extensions-1.0.0-rc.7-dev.3.tgz",
    "@feelpp/asciidoctor-extensions": "file:vendor/npm/feelpp-asciidoctor-extensions-1.0.0-rc.18-dev.2.tgz",
    "asciidoctor-jupyter": "0.7.0",
    "handlebars": "4.7.9",
    "handlebars-utils": "1.0.6",
    "katex": "0.16.22"
  },
  "devDependencies": {
    "http-server": "14.1.1"
  },
  "overrides": {
    "js-yaml@^4.0.0": "4.3.2"
  },
  "license": "SEE LICENSE.md"
}
