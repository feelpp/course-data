+++ b/lib/depth-guard.js
@@ -0,0 +1,26 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm; limits cannot be disabled by options.
+const MAX_DEPTH = 100;
+
+exports.checkDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    throw new SyntaxError(`Brace nesting exceeds maximum depth (${MAX_DEPTH})`);
+  }
+};
+
+// Follow child nodes only: parsed ASTs also contain parent/previous backlinks.
+// Iterative validation protects callers supplying an AST directly to a walker.
+exports.assertAstDepth = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  while (stack.length) {
+    const { node, depth } = stack.pop();
+    // A leaf can sit one level below the deepest brace/parenthesis block.
+    exports.checkDepth(Math.max(0, depth - 1));
+    if (node && node.nodes) {
+      for (const child of node.nodes) {
+        stack.push({ node: child, depth: depth + 1 });
+      }
+    }
+  }
+};
